: "${GEMMA4_IMAGE:=tenhkspark/gemma-4-v2:v2}"
: "${GEMMA4_MODEL:=$HOME/models/gemma-4-26B-A4B-NVFP4-lmfp8}"
: "${GEMMA4_PORT:=8890}"
: "${GEMMA4_MTP:=8}"
: "${GEMMA4_MTP_DIR:=$HOME/models/gemma-4-26B-A4B-it-assistant}"
: "${GEMMA4_KV:=fp8}"
: "${GEMMA4_LMO:=1}"
: "${GEMMA4_JIT_CACHE:=}"
: "${GEMMA4_CHAT_TEMPLATE:=}"
: "${GEMMA4_GPU_UTIL:=0.50}"
: "${GEMMA4_MAX_LEN:=32768}"
: "${GEMMA4_MAX_SEQS:=32}"
: "${GEMMA4_BATCHED_TOKENS:=8192}"
: "${GEMMA4_PREFIX_CACHE:=0}"
: "${GEMMA4_CONTAINER:=gemma4-v2-serve}"
: "${GEMMA4_SERVED_NAME:=gemma4}"
: "${GEMMA4_READY_S:=1800}"
: "${GEMMA4_EXTRA_ARGS:=}"
export GEMMA4_IMAGE GEMMA4_MODEL GEMMA4_PORT GEMMA4_MTP \
  GEMMA4_MTP_DIR GEMMA4_KV GEMMA4_LMO GEMMA4_JIT_CACHE GEMMA4_MAX_LEN GEMMA4_MAX_SEQS \
  GEMMA4_BATCHED_TOKENS GEMMA4_PREFIX_CACHE GEMMA4_GPU_UTIL \
  GEMMA4_CONTAINER GEMMA4_SERVED_NAME GEMMA4_READY_S GEMMA4_EXTRA_ARGS \
  GEMMA4_CHAT_TEMPLATE
