# gemma4.small.env -- config for serve.sh (one-node Gemma 4 serve on a discrete GPU).
# Estimated values for a ~32GB discrete GPU; not measured outside DGX Spark.
# Env vars already set win over these defaults; edit here for the run.
: "${GEMMA4_IMAGE:=tenhkspark/vllm-gb10:v0.28.0-sm121}"       # docker pull, or build per BRING-UP.md
: "${GEMMA4_MODEL:=$HOME/models/gemma-4-26B-A4B-NVFP4-lmfp8}"  # absolute path to the untied-lm_head ckpt (or HF id once distributed)
: "${GEMMA4_PORT:=8890}"
: "${GEMMA4_MTP:=8}"                                  # 0=off, else num_speculative_tokens (2|3|4|6|8)
: "${GEMMA4_MTP_DIR:=$HOME/models/gemma-4-26B-A4B-it-assistant}" # assistant draft dir or HF id; required iff MTP>0
                                                      #   (e.g. google/gemma-4-26B-A4B-it-assistant)
: "${GEMMA4_KV:=fp8}"                                 # auto|fp8 (fp8 = --kv-cache-dtype fp8)
: "${GEMMA4_LMO:=1}"                                  # 1=--language-model-only (disables all mm inputs)
: "${GEMMA4_JIT_CACHE:=}"                             # optional host dir for triton/inductor caches
: "${GEMMA4_GPU_UTIL:=0.85}"                          # --gpu-memory-utilization
: "${GEMMA4_MAX_LEN:=8192}"
: "${GEMMA4_MAX_SEQS:=8}"
: "${GEMMA4_BATCHED_TOKENS:=8192}"                    # --max-num-batched-tokens (chunked prefill size)
: "${GEMMA4_PREFIX_CACHE:=0}"                         # 1=--enable-prefix-caching, 0=--no-enable-prefix-caching (measured config is 0)
: "${GEMMA4_CONTAINER:=gemma4-serve}"
: "${GEMMA4_SERVED_NAME:=gemma4}"
: "${GEMMA4_READY_S:=1800}"                           # up: READY wait ceiling, seconds
: "${GEMMA4_EXTRA_ARGS:=}"                            # extra flags appended to `vllm serve`
export GEMMA4_IMAGE GEMMA4_MODEL GEMMA4_PORT GEMMA4_MTP \
  GEMMA4_MTP_DIR GEMMA4_KV GEMMA4_LMO GEMMA4_JIT_CACHE GEMMA4_MAX_LEN GEMMA4_MAX_SEQS \
  GEMMA4_BATCHED_TOKENS GEMMA4_PREFIX_CACHE GEMMA4_LMO GEMMA4_GPU_UTIL \
  GEMMA4_CONTAINER GEMMA4_SERVED_NAME GEMMA4_READY_S GEMMA4_EXTRA_ARGS
